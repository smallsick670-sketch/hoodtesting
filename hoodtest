local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

local FOV_RADIUS = 50
local PREDICTION_FACTOR = 0.11
local SMOOTHNESS = 0.25

local function applyForceFieldGreen(part: Instance)
	if part:IsA("BasePart") or part:IsA("MeshPart") then
		part.Material = Enum.Material.ForceField
		part.Color = Color3.fromRGB(0, 255, 0)
	end
end

local function watchModel(model: Instance)
	for _, descendant in ipairs(model:GetDescendants()) do
		applyForceFieldGreen(descendant)
	end

	model.DescendantAdded:Connect(function(descendant)
		applyForceFieldGreen(descendant)
	end)
end

local function setupViewModelTracking(viewmodelFolder: Instance)
	local function checkAndWatch(child: Instance)
		if child:IsA("Model") then
			watchModel(child)
			for _, subChild in ipairs(child:GetDescendants()) do
				if subChild:IsA("Model") then
					watchModel(subChild)
				end
			end
		end
	end

	for _, child in ipairs(viewmodelFolder:GetChildren()) do
		checkAndWatch(child)
	end

	viewmodelFolder.ChildAdded:Connect(checkAndWatch)
end

local viewmodelFolder = Camera:FindFirstChild("Viewmodel")
if viewmodelFolder then
	setupViewModelTracking(viewmodelFolder)
end

Camera.ChildAdded:Connect(function(child)
	if child.Name == "Viewmodel" then
		setupViewModelTracking(child)
	end
end)

